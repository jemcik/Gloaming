<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- User-granted (Alarms & reminders). Deliberately NOT USE_EXACT_ALARM:
         Play restricts that to alarm/timer/calendar apps and reviews it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Normal, granted at install, no prompt. AOSP's clock guards the activity
         that answers SHOW_ALARMS with it - the same one that answers SET_ALARM
         - and Honor's Clock inherits that. Without it the door under "end
         bedtime at your alarm" RESOLVES, so it is drawn, and the launch is
         then refused: measured 11 Sep 2026, a tap that did nothing. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Samsung keeps its always-on keys in Settings.System, where WRITE_SETTINGS
         is the guard - and unlike WRITE_SECURE_SETTINGS the user can grant that
         themselves, on a normal settings screen. See AmbientControl. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Not grantable at install and there is no runtime prompt for it: this is
         signature|privileged, so only adb can grant it, and AmbientControl is
         inert without it. Declared so a user who wants the vendor always-on
         route can opt in with one command. See AmbientControl. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Samsung's Modes and Routines lists a user's manual routines and starts or
         ends one on request, through a content provider it gates on THIS - and
         it is protectionLevel normal: granted at install, no prompt. Undefined
         on every other phone, where declaring it costs nothing. See Routines. -->
    <uses-permission android:name="com.samsung.android.app.routines.permission.READ_ROUTINE_INFO" />

    <!-- Without this, resolveActivity cannot see the vendor's auto-launch
         screen at all and BootWatch would always fall back to app details. -->
    <queries>
        <package android:name="com.hihonor.systemmanager" />
        <!-- Samsung's Modes and Routines: the provider Routines drives, and the
             package so its Routines tab can be opened from the picker. -->
        <package android:name="com.samsung.android.app.routines" />
        <provider android:authorities="com.samsung.android.app.routines.externalprovider" />
        <!-- So resolveActivity can SEE the contacts app's starred screen. We
             never read contacts - launching an activity needs no permission -
             but without this the resolve returns null and the row would hide
             itself on a phone where it would have worked. -->
        <intent>
            <action android:name="com.android.contacts.action.LIST_STARRED" />
        </intent>
        <!-- And the fallback door, for phones that answer neither: Samsung
             ships its own Contacts and does not handle LIST_STARRED at all. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <!-- The clock app's alarm list, the door under "end bedtime at your
             alarm". A platform intent every clock answers; see Doors.hasAlarms. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>


    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gloaming"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing a custom tile opens whichever activity answers
                 this; with nothing declared the system falls back to the App
                 info page, which is not what a long press on a bedtime tile
                 should mean. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Lets the system open our settings from the DND rule entry -->
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Exported on purpose: the sender is the system. See the class. -->
        <receiver android:name=".core.ZenStatusReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE_STATUS_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".core.BedtimeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- The morning alarm may move, and the end of the night moves
                     with it when "end at the next alarm" is on. -->
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- How the routine file reaches Samsung's importer. Not exported; the
             importer gets a one-off read grant on one cache file, and nothing
             else of ours is reachable through it. See Routines.offer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.jemcik.gloaming.routine"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/routine_paths" />
        </provider>

        <!-- The master switch in the shade. It is the same control as the app
             bar's, sharing Bedtime.set and statusLine, so the two cannot drift.
             BIND_QUICK_SETTINGS_TILE is what lets SystemUI bind it, and is
             declared on the service rather than requested by the app.

             THE ICON HERE IS THE PICKER'S, and it is the only face the tile has
             before the service has ever run. "Add tile" draws this one; render()
             has not been reached, because the tile is not on the panel yet to be
             listened to. So it must be the mark the tile wears at REST -
             ic_gloaming_tile, the same drawable render() picks when bedtime is
             off - or adding the tile changes its icon under the user's hand.
             It was ic_bedtime, Google's crescent, which is the switch's RUNNING
             glyph and, in a picker three rows from the system's own moons, not
             recognisably this app at all. -->
        <service
            android:name=".ui.BedtimeTile"
            android:exported="true"
            android:icon="@drawable/ic_gloaming_tile"
            android:label="@string/bedtime_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
