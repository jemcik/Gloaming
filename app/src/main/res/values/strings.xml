    <!-- ============ Home: which days ============ -->
    <string name="section_which_days">which days</string>
    <!-- A row's supporting line must not WRAP. Past one line the row becomes a
         three-line ListItem, and M3 then top-aligns the trailing content, so the
         switch stops being level with its own row. Reported as exactly that.

         The width left for it depends on what is to its left, so the budgets
         differ: ~171dp beside a bare icon, ~151dp where a switch also sits. Characters are only a proxy - Cyrillic is
         wider, and a 24-character Ukrainian subtitle wrapped where a
         25-character English one did not - so these are set for the widest
         script, and were checked by RENDERING the app in Ukrainian, which is
         where two of them were caught.
         BUDGET-EACH 22 fx_grayscale_sub fx_dim_sub fx_dark_sub fx_ambient_sub settings_language_why
         BUDGET-EACH 20 row_media_on row_repeat_callers_on state_allowed state_blocked -->
    <!-- BUDGET 30 preset_every_night preset_weekdays preset_weekends
         The four share one row: 311dp of content width, less 16dp of padding per
         chip, leaves 247dp for text. Cyrillic runs about 8dp per character
         against Latin's 7.2, so a character count flatters it - 26 is the honest
         limit, and it is on the SUM, not on any one label. "Always" rather than
         "Every night" is what bought the room: measured at 14sp, all three
         languages now end at 327dp of the 335dp margin, on one row. -->
    <string name="preset_every_night">Always</string>
    <string name="preset_weekdays">Weekdays</string>
    <string name="preset_weekends">Weekends</string>
