<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Gloaming</string>

    <!-- ============ Home: the master card ============ -->
    <string name="bedtime_mode">Bedtime mode</string>
    <string name="bedtime_off">Off</string>
    <string name="state_on_now">On now</string>
    <!-- BUDGET-EACH 18 state_on_until state_starts_in
         These share one line with the switch inside the master card - about
         190dp - and the duration they carry can reach "11 hr 59 min". They are
         capped at one line in code, so anything longer than this is not wrapped,
         it is TRUNCATED. Measured: the Ukrainian "Почнеться через %1$s" needed
         more than 190dp and wrapped, which made the card grow and shrink under
         the finger dragging the dial. -->
    <string name="state_on_until">On now, until %1$s</string>
    <string name="state_starts_in">Starts in %1$s</string>
    <string name="state_nothing_scheduled">Nothing scheduled</string>
    <string name="badge_once">Once</string>

    <!-- Durations. Hours and minutes are separate so a language with more than
         two plural forms can inflect each one. -->
    <plurals name="dur_minutes">
        <item quantity="one">%d min</item>
        <item quantity="other">%d min</item>
    </plurals>
    <plurals name="dur_hours">
        <item quantity="one">%d hr</item>
        <item quantity="other">%d hr</item>
    </plurals>
    <string name="dur_hours_minutes">%1$s %2$s</string>
    <!-- The dial centre. Seven glyphs is the worst case ("11h 59m") and the
         numeral is 36sp: keep this compact or it will not clear the centre well. -->
    <string name="dur_compact">%1$dh %2$02dm</string>

