<?xml version="1.0" encoding="utf-8"?>
<!-- Schema taken from Samsung Clock's own bixby_routines_condition_meta,
     res/D5M.xml in /system/priv-app/Routines. Two entries deliberately: the
     only triggerType seen in the wild is "event", and bedtime is a STATE, so
     both are declared. If only one is listed by One UI, that names the valid
     value; if neither appears, discovery itself is closed to non-system apps,
     which is the question this exists to answer. -->
<conditions>
    <condition
        category="lifestyle"
        icon="@drawable/ic_gloaming"
        label="@string/app_name"
        tag="bedtime_active"
        triggerType="state" />
    <condition
        category="lifestyle"
        icon="@drawable/ic_gloaming"
        label="@string/app_name"
        tag="bedtime_started"
        triggerType="event" />
</conditions>
